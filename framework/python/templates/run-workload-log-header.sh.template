##########  Status tracking ##########
# Exit codes: 0 = every workload PASSED, 1 = at least one workload FAILED,
#             2 = infrastructure/precheck error (run aborted), 130 = interrupted.
# Kept compatible with bash 3.2 (macOS): indexed arrays only.

ALL_WORKLOADS=()
WORKLOAD_NAMES=()
WORKLOAD_STATUS=()
WORKLOAD_REASONS=()
WORKLOAD_ELAPSED=()
WORKLOAD_TEST_RUN=()
CURRENT_WORKLOAD=""
WORKLOAD_START=""
WORKLOAD_TEST_DURATION=""
APPLIED_CR=""
wl_reasons=""

# Case-insensitive patterns used to scan pod logs. Override with environment variables if needed.
LOG_ERROR_PATTERN="$${SAS_VALIDATION_LOG_ERROR_PATTERN:-error|traceback|exception}"
LOG_IGNORE_PATTERN="$${SAS_VALIDATION_LOG_IGNORE_PATTERN:-^ *error report *$$|# *occurrences +error}"
RESULT_MARKER="SAS_VALIDATION_RESULT"

# Convert a duration such as 90, 45s, 30m, 1h or 1h30m to seconds; prints -1 if it can't be parsed.
duration_to_seconds() {
  echo "$$1" | awk '{
    s = $$0; t = 0
    while (match(s, /^[0-9]+[hms]?/)) {
      tok = substr(s, 1, RLENGTH); s = substr(s, RLENGTH + 1)
      u = substr(tok, length(tok)); n = tok + 0
      if (u == "h") t += n * 3600; else if (u == "m") t += n * 60; else t += n
    }
    if (s != "" || $$0 == "") t = -1
    print t
  }'
}

# Final state of a Locust test. Uses the LocustTest phase set by the operator; if it isn't final, the
# Locust master container's own termination state decides. Operator <= 2.2.3 runs the metrics exporter
# as a regular container that never exits, so the master Job (and the phase) never complete there.
# Prints Succeeded, Failed, Running, Pending or Unknown.
locust_phase() {
  local phase exit_code
  phase=$$(kubectl -n ${namespace} get locusttests.locust.io "$$1.test" -o jsonpath='{.status.phase}' 2>/dev/null)
  case "$$phase" in
    Succeeded|Failed) echo "$$phase"; return ;;
  esac
  exit_code=$$(kubectl -n ${namespace} get pod -l job-name="$$1-test-master" \
    -o jsonpath='{range .items[*].status.containerStatuses[*]}{.name}={.state.terminated.exitCode}{"\n"}{end}' 2>/dev/null \
    | grep "^$$1-test-master=" | head -1 | cut -d= -f2)
  if [ -n "$$exit_code" ]; then
    if [ "$$exit_code" = "0" ]; then echo "Succeeded"; else echo "Failed"; fi
    return
  fi
  echo "$${phase:-Unknown}"
}

# Value of a "SAS_VALIDATION_RESULT <key> <value>" line published by the Locust master (events.py).
# Usage: result_value <key> <log file>...
result_value() {
  local key="$$1"
  shift
  cat "$$@" 2>/dev/null | grep "^$$RESULT_MARKER $$key " | tail -1 | awk '{print $$3}'
}

# Decode a published gzip+base64 CSV into a file. Usage: extract_result <key> <dest> <log file>...
extract_result() {
  local key="$$1" dest="$$2" payload
  shift 2
  payload=$$(result_value "$$key" "$$@")
  [ -n "$$payload" ] || return 1
  if ! printf '%s' "$$payload" | base64 --decode 2>/dev/null | gunzip > "$$dest" 2>/dev/null; then
    rm -f "$$dest"
    return 1
  fi
}

add_reason() {
  if [ -z "$$wl_reasons" ]; then
    wl_reasons="$$1"
  else
    wl_reasons="$$wl_reasons; $$1"
  fi
}

record_result() {
  WORKLOAD_NAMES+=("$$1")
  WORKLOAD_STATUS+=("$$2")
  WORKLOAD_REASONS+=("$$3")
  if [ -n "$$WORKLOAD_START" ]; then
    WORKLOAD_ELAPSED+=("$$(format_duration $$(( SECONDS - WORKLOAD_START )))")
  else
    WORKLOAD_ELAPSED+=("-")
  fi
  WORKLOAD_TEST_RUN+=("$${WORKLOAD_TEST_DURATION:--}")
}

# Format seconds as H:MM:SS.
format_duration() {
  printf "%d:%02d:%02d" $$(( $$1 / 3600 )) $$(( $$1 % 3600 / 60 )) $$(( $$1 % 60 ))
}

# Number of data rows (excluding the header) in a CSV file; 0 if the file is missing.
csv_data_rows() {
  if [ -s "$$1" ]; then
    awk 'NR > 1 && NF > 0' "$$1" | wc -l | tr -d ' '
  else
    echo 0
  fi
}

print_summary() {
  local i j name status reason recorded overall=0
  echo ""
  echo "=============================================================="
  echo " WORKLOAD SUMMARY"
  echo "=============================================================="
  printf "%-40s %-8s %s\n" "WORKLOAD" "STATUS" "REASON"
  for ((i = 0; i < $${#WORKLOAD_NAMES[@]}; i++)); do
    printf "%-40s %-8s %s\n" "$${WORKLOAD_NAMES[$$i]}" "$${WORKLOAD_STATUS[$$i]}" "$${WORKLOAD_REASONS[$$i]}"
    if [ "$${WORKLOAD_STATUS[$$i]}" != "PASSED" ]; then
      overall=1
    fi
  done
  for name in "$${ALL_WORKLOADS[@]}"; do
    recorded=0
    for ((j = 0; j < $${#WORKLOAD_NAMES[@]}; j++)); do
      if [ "$${WORKLOAD_NAMES[$$j]}" = "$$name" ]; then recorded=1; fi
    done
    if [ $$recorded -eq 0 ]; then
      printf "%-40s %-8s %s\n" "$$name" "NOT RUN" "run aborted before this workload started"
      overall=1
    fi
  done
  if [ $${#WORKLOAD_NAMES[@]} -eq 0 ] && [ $${#ALL_WORKLOADS[@]} -eq 0 ]; then
    echo "(no workloads were executed)"
    overall=1
  fi
  echo "=============================================================="
  echo " DURATIONS (H:MM:SS)"
  echo "=============================================================="
  printf "%-40s %-12s %s\n" "WORKLOAD" "TEST RUN" "ELAPSED"
  for ((i = 0; i < $${#WORKLOAD_NAMES[@]}; i++)); do
    printf "%-40s %-12s %s\n" "$${WORKLOAD_NAMES[$$i]}" "$${WORKLOAD_TEST_RUN[$$i]}" "$${WORKLOAD_ELAPSED[$$i]}"
  done
  printf "%-40s %-12s %s\n" "TOTAL RUN" "" "$$(format_duration $$SECONDS)"
  echo "TEST RUN = Locust test duration reported by the master; ELAPSED = deploy, run, and result collection."
  echo "=============================================================="
  if [ $$overall -eq 0 ]; then
    echo " OVERALL: PASSED"
  else
    echo " OVERALL: FAILED"
  fi
  echo "=============================================================="
  return $$overall
}

# Abort the whole run on an infrastructure failure (namespace, CRD, configmap, CR apply...).
fail_infra() {
  echo ""
  echo "********************************"
  echo " INFRASTRUCTURE ERROR - RUN ABORTED"
  echo "********************************"
  echo "$$1"
  echo "Run 'sas-validation preflight' to diagnose the cluster setup."
  if [ -n "$$CURRENT_WORKLOAD" ]; then
    record_result "$$CURRENT_WORKLOAD" "ERROR" "$$1"
    CURRENT_WORKLOAD=""
  fi
  print_summary
  exit 2
}

on_exit() {
  local rc=$$?
  trap - EXIT
  trap '' INT TERM HUP
  if [ -n "$$APPLIED_CR" ]; then
    kubectl -n ${namespace} delete -f "$$APPLIED_CR" --ignore-not-found >/dev/null 2>&1
  fi
  kubectl -n ${namespace} delete configmap ${config_map_name} --ignore-not-found >/dev/null 2>&1
  exec 2>&4 1>&3
  local waited=0
  while kill -0 "$$TEE_PID" 2>/dev/null && [ $$waited -lt 20 ]; do
    sleep 0.1
    waited=$$(( waited + 1 ))
  done
  if kill -0 "$$TEE_PID" 2>/dev/null; then
    echo "WARNING: forcing the run log writer to stop; its output may be incomplete." >&2
    kill -KILL "$$TEE_PID" 2>/dev/null
  fi
  wait "$$TEE_PID" 2>/dev/null
  exit $$rc
}
trap on_exit EXIT
trap 'echo "Interrupted."; exit 130' INT TERM HUP

##########  Precheck ##########

run_precheck() {
  local ns_output
  command -v kubectl >/dev/null 2>&1 || fail_infra "kubectl was not found on PATH."

  ns_output=$$(kubectl get namespace ${namespace} 2>&1)
  if [ $$? -ne 0 ]; then
    if echo "$$ns_output" | grep -qi "forbidden"; then
      echo "WARNING: not allowed to read namespace '${namespace}'; continuing. ($$ns_output)"
    else
      fail_infra "Namespace '${namespace}' is not available: $$ns_output"
    fi
  fi

  if ! kubectl api-resources --api-group=locust.io -o name 2>/dev/null | grep -q '^locusttests'; then
    fail_infra "The LocustTest CRD (locusttests.locust.io) is not installed in the cluster. Install the locust-k8s-operator first."
  fi
}
